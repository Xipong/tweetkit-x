+    monkeypatch.setenv('PYTHONPATH', str(tmp_path) + os.pathsep + os.environ.get('PYTHONPATH', ''))
+    audio, transcript = tmp_path / 'ref.wav', tmp_path / 'ref.txt'
+    audio.touch()
+    transcript.write_text('reference transcript')
